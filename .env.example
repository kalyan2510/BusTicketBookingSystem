# Copy this file to .env and fill in your own values.
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_ENGINE=mysql
DB_NAME=busgo_db
DB_USER=busgo_user
DB_PASSWORD=your-database-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_TEST_NAME=test_busgo_db

SEAT_RESERVATION_MINUTES=15
MAX_SEATS_PER_BOOKING=6
CONVENIENCE_FEE_PER_SEAT=30
GST_PERCENT=5

PAYMENT_MODE=simulated
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

SITE_EMAIL=support@busgo.in
SITE_PHONE=+91 98765 43210
SITE_ADDRESS=3rd Floor, Travel House, MG Road, Bengaluru, Karnataka 560001

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=BUSGO <no-reply@busgo.in>
